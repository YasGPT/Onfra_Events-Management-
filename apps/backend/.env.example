# Copy to .env and fill in your own values. Never commit a real .env.

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
SYNC_DB=false

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Mail (attendee approval / password setup links) ---
# "log" prints every email to the server console (development default).
# "smtp" delivers through the SMTP_* settings below.
MAIL_DRIVER=log
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Base URL used inside emails to build the password setup link
CLIENT_URL=http://localhost:5173
PASSWORD_SETUP_TOKEN_HOURS=72
