# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Either provide a full connection URL:
DATABASE_URL=postgres://postgres@localhost:5432/confra

# Or configure individual credentials:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=confra
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Auth
# REQUIRED. Minimum 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real secret. Server refuses to start without it.
JWT_SECRET=replace-with-a-random-48-byte-hex-string
# Optional. Access token lifetime (default 15m).
# ACCESS_TOKEN_TTL=15m
