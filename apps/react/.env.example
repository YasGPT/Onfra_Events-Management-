# Confra Admin Web - local development environment
# Copy to .env and adjust if your setup differs.

# Base path the app calls. In dev this is proxied by Vite to the backend,
# so no CORS configuration is needed in the browser.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards every /api request (Express backend).
VITE_PROXY_TARGET=http://localhost:5000
